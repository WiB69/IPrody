# Database configuration - Payment Service
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_pass
PAYMENT_DB_PORT=5432

# Database configuration - Customer Service
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=customer_user
CUSTOMER_DB_PASSWORD=customer_pass
CUSTOMER_DB_PORT=5433

# Database configuration - Inquiry Service
INQUIRY_DB_NAME=inquiry_db
INQUIRY_DB_USER=inquiry_user
INQUIRY_DB_PASSWORD=inquiry_pass
INQUIRY_DB_PORT=5434

# Database configuration - Inventory Service
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_pass
INVENTORY_DB_PORT=5435

# Payment Service configuration
PAYMENT_SERVICE_PORT=9080
PAYMENT_SERVICE_TLS_PORT=9443
DEBUG_PORT=9005

# Customer Service configuration
CUSTOMER_SERVICE_PORT=8080
CUSTOMER_SERVICE_TLS_PORT=8443
CUSTOMER_DEBUG_PORT=8005

# Inquiry Service configuration
INQUIRY_SERVICE_PORT=7080
INQUIRY_SERVICE_TLS_PORT=7443
INQUIRY_DEBUG_PORT=7005

# Inventory Service configuration
INVENTORY_SERVICE_PORT=6080
INVENTORY_SERVICE_TLS_PORT=6443
INVENTORY_DEBUG_PORT=6005

# Common Spring profile
SPRING_PROFILE=local

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_pass
KEYCLOAK_PORT=10082

